 <application android:theme="@android:style/Theme.Material.NoActionBar" android:label="Taxi Driver Test" android:allowBackup="false" android:usesCleartextTraffic="false">
  <activity android:name=".MainActivity" android:exported="true">
   <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
  </activity>
 <service android:name=".MeterService" android:foregroundServiceType="location" android:exported="false" android:stopWithTask="false"/>
